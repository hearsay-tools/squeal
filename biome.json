{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!docs",
      "!test/fixtures",
      "!evals/ledgerline",
      "!evals/results",
      "!plugins/codex-runtime",
      "!plugins/codex/seed"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/core/keys/index.ts",
        "src/runners/observe/index.ts",
        "test/keys/validity/driver.ts",
        "test/keys/validity/entries/*.ts",
        "evals/**"
      ],
      "linter": {
        "rules": { "performance": { "noBarrelFile": "off", "noReExportAll": "off" } }
      }
    },
    {
      "includes": [
        "src/core/delivery/index.ts",
        "src/core/fs/index.ts",
        "src/core/hash/index.ts",
        "src/core/revision/index.ts",
        "src/core/scheduler/index.ts",
        "src/core/store/index.ts",
        "src/core/types/index.ts",
        "src/runners/vitest/paths.ts"
      ],
      "linter": {
        "rules": { "performance": { "noBarrelFile": "off", "noReExportAll": "off" } }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
