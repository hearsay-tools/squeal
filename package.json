{
  "name": "squeal",
  "version": "0.1.14",
  "private": true,
  "description": "Continuous validation layer for coding agents. Push transitions, pull state.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "squeal": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugins"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:plugin",
    "build:plugin": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/harness/claude-code/build.ts",
    "check:version": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-version-bump.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vitest": ">=5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "optionalDependencies": {
    "@parcel/watcher": "^2.6.0"
  }
}
