+          set -- npm test -- --shard=1/4 --maxWorkers=4 --coverage.enabled
+          if [ "$PROOF_RUN" = squeal ]; then
+            set -- squeal ci record --out "$out/parts" -- "$@"
+          fi
+          load_before="$(cut -d ' ' -f 1 /proc/loadavg 2> /dev/null || true)"
+          code=0
+          TIMEFORMAT='%3R %3U %3S'
+          { time "$@" 2>&3 || code=$?; } 3>&2 2> "$out/time.txt"
+          load_after="$(cut -d ' ' -f 1 /proc/loadavg 2> /dev/null || true)"
+          read -r wall user sys < "$out/time.txt" || true
+          if ! cp .ai/qa/coverage/coverage-final.json "$out/coverage-final.json"; then
+            echo "::warning title=Squeal coverage proof $PROOF_RUN::No V8 coverage report (exit $code)."
+          fi
+          jq -n --arg run "$PROOF_RUN" --argjson code "$code" --arg wall "$wall" --arg user "$user" --arg sys "$sys" \
+            --arg root "$GITHUB_WORKSPACE" --arg cpus "$(getconf _NPROCESSORS_ONLN)" --arg model "$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo 2> /dev/null | head -n 1)" \
+            --arg loadBefore "$load_before" --arg loadAfter "$load_after" --argjson command "$(printf '%s\0' "$@" | jq -cRs 'split("\u0000")[:-1]')" \
+            '{format: "squeal-coverage-proof-run/1", run: $run, command: $command, exitCode: $code,
+              wallSeconds: ($wall | tonumber? // null), userSeconds: ($user | tonumber? // null), sysSeconds: ($sys | tonumber? // null),
+              root: $root, cpus: ($cpus | tonumber? // null), cpuModel: $model,
+              loadBefore: ($loadBefore | tonumber? // null), loadAfter: ($loadAfter | tonumber? // null)}' > "$out/run.json"
+          echo "Squeal coverage proof $PROOF_RUN: exit $code, wall ${wall:-unknown} s, CPU ${user:-unknown} s user and ${sys:-unknown} s sys."
+
+      - name: Upload the proof run
+        if: always()
+        continue-on-error: true
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: squeal-coverage-proof-${{ matrix.run }}
+          path: ${{ runner.temp }}/squeal-coverage-proof/
+          if-no-files-found: warn
+          retention-days: 14
+          overwrite: true
+
+  squeal-coverage-proof-compare:
