{
  "interrupt": {
    "onRegression": true
  },
  "stop": {
    "blockOnKnownFailures": false,
    "requireFullSuite": false,
    "waitMs": 0,
    "requireSlowSuite": false,
    "slowWaitMs": 120000
  },
  "testCommand": {
    "denyWhenCurrent": false
  },
  "baseline": {
    "onStart": "lookup-then-run-missing"
  },
  "inputs": {
    "packages/cezar/test/e2e/**": [
      "packages/cezar/dist/**"
    ]
  },
  "observe": {
    "runtimeInputs": true
  },
  "env": {
    "allowlist": []
  },
  "runner": {
    "tierSize": 4,
    "backlogTierSize": 200,
    "timeoutMs": 600000
  },
  "nodeTest": [
    {
      "name": "test:unit",
      "cwd": "packages/cezar",
      "argv": [
        "--import",
        "../../scripts/test-git-env.mjs",
        "--import",
        "tsx"
      ],
      "include": [
        "test/unit/*.test.ts"
      ]
    },
    {
      "name": "test:package",
      "cwd": "packages/cezar",
      "argv": [
        "--import",
        "../../scripts/test-git-env.mjs",
        "--import",
        "tsx"
      ],
      "include": [
        "test/e2e/*.test.ts"
      ]
    }
  ],
  "slow": {
    "include": [
      "packages/cezar/test/e2e/**"
    ],
    "maxWorkers": 2,
    "maxLoadPerCpu": 1,
    "maxDeferMs": 600000,
    "maxParallel": 4
  },
  "delivery": {
    "uncoveredEdits": true
  },
  "daemon": {
    "idleExitMinutes": 60
  },
  "store": {
    "retentionDays": 7,
    "maxSizeMb": null
  }
}
