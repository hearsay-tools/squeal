@@ -322,3 +322,29 @@
     ),
   );
 }
+
+/** PROBE 011-420 (q): publish a quiet lane's demand only this long before its wait ends. */
+export const QUIET_DEMAND_LEAD_MS = Number(process.env.SQUEAL_PROBE_QUIET_LEAD_MS ?? 30_000);
+
+/**
+ * PROBE 011-420 (q): the backlog files a wait for quiet holds whose end is
+ * within `QUIET_DEMAND_LEAD_MS`, at most 64: what the lane's first backlog
+ * tier will ask for once the wait ends. 0 when none.
+ */
+export function quietDemand(context: SchedulerContext, ledger: Ledger, now: EpochMs): number {
+  const { quiet } = context;
+  if (quiet === undefined) return 0;
+  const { queue } = ledger;
+  const soon = (ends: ReadonlyMap<string, EpochMs>) =>
+    new Set([...ends].filter(([, end]) => end - now <= QUIET_DEMAND_LEAD_MS).map(([lane]) => lane));
+  const backlog = soon(quiet.ends(now));
+  const catchUp = soon(quiet.catchUpEnds(now));
+  if (backlog.size === 0 && catchUp.size === 0) return 0;
+  let n = 0;
+  queue.hasFast((ref) => {
+    const lane = laneOf(context, ref);
+    if (backlog.has(lane) || (catchUp.has(lane) && queue.isCatchUp(ref))) n++;
+    return n >= 64;
+  });
+  return n;
+}
