+/** PROBE 011-413 (a): a backlog tier holding at most this many permits leaves room beside it. */
+export const PROBE_NARROW_PERMITS = 4;
+
+/**
+ * PROBE 011-413 (a): the lanes whose runner cancels a run, whose backlog tier
+ * in flight (not a batch's, not beside) holds at most `PROBE_NARROW_PERMITS`
+ * permits now (a narrow grant, or a wide tier's tail), and that hold no tier
+ * beside it.
+ */
+export function narrowLanes(context: SchedulerContext, inFlight: readonly Tier[]): Set<string> {
+  const lanes = new Set<string>();
+  for (const tier of inFlight) {
+    const first = tier.files[0]?.file.ref;
+    if (tier.kind !== "backlog" || tier.promoted === true || tier.beside === true) continue;
+    if (tier.lease === undefined || first === undefined || !cancels(context, first)) continue;
+    if (tier.cancel?.signal.aborted === true) continue;
+    if (tier.lease.permits <= PROBE_NARROW_PERMITS) lanes.add(tier.lane);
+  }
+  for (const tier of inFlight) if (tier.beside === true) lanes.delete(tier.lane);
+  return lanes;
+}
