+/** PROTOTYPE: the workers a backlog tier of `lane` runs with at a grant of `grant`. */
+function laneWidth(context: SchedulerContext, lane: string, grant: number): number {
+  // node:test and pytest run `runner.tierSize` processes at once whatever the grant.
+  if (lane.startsWith("node-test") || lane.startsWith("pytest")) return context.policy.runner.tierSize;
+  return Math.max(2, Math.floor(grant)); // Vitest: `tierWidth`'s floor of 2, no project ceiling known here.
+}
+
+/** PROTOTYPE: makespan of files started in order on the earliest free of `width` workers. */
+class WallEstimate {
+  readonly #free: number[];
+  #makespan = 0;
+  constructor(width: number) {
+    this.#free = Array.from({ length: Math.max(1, width) }, () => 0);
+  }
+  with(durationMs: number): number {
+    return Math.max(this.#makespan, Math.min(...this.#free) + durationMs);
+  }
+  add(durationMs: number): void {
+    const i = this.#free.indexOf(Math.min(...this.#free));
+    this.#free[i] = (this.#free[i] ?? 0) + durationMs;
+    this.#makespan = Math.max(this.#makespan, this.#free[i] ?? 0);
+  }
+}
