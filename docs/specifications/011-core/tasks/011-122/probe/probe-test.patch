 export function spawnDaemon(cli: string, repo: FixtureRepo): SpawnedProcess {
-  return spawnCli(cli, ["daemon", repo.root], { cwd: repo.root, env: repo.env });
+  const cpus = process.env.PROBE_TASKSET;
+  if (cpus === undefined || cpus === "") {
+    return spawnCli(cli, ["daemon", repo.root], { cwd: repo.root, env: repo.env });
+  }
+  // Probe 011-122: the daemon's process tree on these CPUs only, beside the busy loops there.
+  const child = spawn("taskset", ["-c", cpus, process.execPath, cli, "daemon", repo.root], {
+    cwd: repo.root,
+    env: repo.env,
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  let out = "";
+  let err = "";
+  child.stdout?.setEncoding("utf8").on("data", (chunk: string) => {
+    out += chunk;
+  });
+  child.stderr?.setEncoding("utf8").on("data", (chunk: string) => {
+    err += chunk;
+  });
+  const exited = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((done) =>
+    child.on("exit", (code, signal) => done({ code, signal })),
+  );
+  return { child, exited, stdout: () => out, stderr: () => err };
 }
 
