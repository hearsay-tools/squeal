+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { environmentHash } from "../../../src/core/keys/environment.js";
+import type { RunnerEnvironment } from "../../../src/core/types/index.js";
+import { openFixture, SLOW } from "./helpers.js";
+
+/*
+ * Probe 011-85, regression 5: a project's environment holds the root's config
+ * file, its own and their dependencies, never a sibling's.
+ */
+
+const core = {
+  squealVersion: "0",
+  nodeVersion: "0",
+  platform: "p",
+  arch: "a",
+  installedDependencies: "",
+  env: {},
+};
+
+function digest(root: string, env: RunnerEnvironment): string {
+  return environmentHash(core, env, (path) => {
+    try {
+      return createHash("sha256").update(readFileSync(join(root, path))).digest("hex");
+    } catch {
+      return null;
+    }
+  });
+}
+
+const E2E = (extra: string) => `import { defineConfig } from "vitest/config";
+import { shared } from "../shared.config.ts";
+${extra}
+export default defineConfig({
+  test: { name: "e2e", include: ["*.e2e.test.ts"], globalSetup: ["./boot.ts"], ...shared },
+});
+`;
+const ROOT = (extra: string) => `import { defineConfig } from "vitest/config";
+import { shared } from "./shared.config.ts";
+${extra}
+export default defineConfig({
+  test: {
+    projects: [
+      { test: { name: "server", include: ["test/server.test.ts"] } },
+      { test: { name: "web", include: ["test/web.test.ts"] } },
+      "e2e/vitest.config.ts",
+    ],
+    ...shared,
+  },
+});
+`;
+
+describe("each project's config files (011-85)", () => {
+  it.each([
+    ["e2e/vitest.config.ts", E2E("// edited"), ["e2e"]],
+    ["vitest.config.ts", ROOT("// edited"), ["e2e", "server", "web"]],
+    ["shared.config.ts", "export const shared = {}; // edited\n", ["e2e", "server", "web"]],
+  ])("an edit of %s re-keys %j", SLOW, async (path, text, moved) => {
+    const fx = await openFixture("five-projects", {
+      "shared.config.ts": "export const shared = {};\n",
+      "vitest.config.ts": ROOT(""),
+      "e2e/vitest.config.ts": E2E(""),
+    });
+    try {
+      const hashes = async () =>
+        Object.fromEntries(
+          (await fx.adapter.environment()).map((env) => [env.project, digest(fx.root, env)]),
+        );
+      const before = await hashes();
+      fx.write(path, text);
+      await fx.adapter.invalidate([{ path, kind: "change" }]);
+      const after = await hashes();
+      const changed = Object.keys(after).filter((p) => after[p] !== before[p]).sort();
+      expect(changed).toEqual(moved);
+    } finally {
+      await fx.adapter.close();
+    }
+  });
+});
