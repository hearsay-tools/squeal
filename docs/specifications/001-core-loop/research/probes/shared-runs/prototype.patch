+/** PROBE 001-201: another live daemon's tier is running `key`. */
+export function claimedElsewhere(context: SchedulerContext, key: CheckKey): boolean {
+  if (process.env.SQUEAL_PROBE_CLAIMS !== "1") return false;
+  const row = connectionOf(context.store).get(
+    `SELECT 1 AS one FROM test_file_keys k JOIN worktrees w ON w.id = k.worktree_id
+     WHERE k.key = ? AND k.pending = 'running' AND k.worktree_id <> ?
+       AND w.daemon_heartbeat_at >= ? - 2 * COALESCE(w.daemon_heartbeat_interval_ms, 5000) LIMIT 1`,
+    key, context.worktreeId, context.now(),
+  );
+  return row !== null;
+}
