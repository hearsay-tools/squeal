#!/bin/sh
# Every hooks.json entry's command (spec 012 CC1). Without arguments it exits 0
# before it reads anything: a harness that keeps an entry's command and drops
# its args, as Cursor CLI does, runs nothing and never reads the hook payload on
# stdin as a script. With them it execs its arguments, so the hook's Node
# process has the harness as its parent. A first argument --if-squeal, the
# per-tool hooks', first tests in sh, with no git or other process, for
# squeal.config.json or a store from $CLAUDE_PROJECT_DIR or else the working
# directory, and exits 0 silently without Squeal (task 001-93).
[ "$#" -gt 0 ] || exit 0
if [ "$1" = --if-squeal ]; then
  shift
  s() {
    [ -n "$1" ] || return 1
    d=$1
    [ -f "$d/squeal.config.json" ] && return 0
    while [ ! -e "$d/.git" ]; do
      [ -n "$d" ] || return 1
      d=${d%/*}
    done
    [ -f "$d/squeal.config.json" ] && return 0
    g=$d/.git
    if [ -f "$g" ]; then
      l=
      IFS= read -r l <"$g"
      g=${l#gitdir:}
      g=${g#"${g%%[! ]*}"}
      case $g in /*) ;; *) g=$d/$g ;; esac
      c=
      [ -f "$g/commondir" ] && IFS= read -r c <"$g/commondir"
      case $c in "") ;; /*) g=$c ;; *) g=$g/$c ;; esac
    fi
    [ -e "$g/squeal" ]
  }
  { s "$CLAUDE_PROJECT_DIR" || s "$PWD"; } 2>/dev/null || exit 0
fi
# Spec 025 D7: a node command starts with Node's compile cache in Squeal's own
# directory when the user set none, marked SQUEAL_OWN_COMPILE_CACHE=1 so test
# processes leave it out; and without NODE_USE_ENV_PROXY's proxy setup, which
# no hook needs: the switch waits in SQUEAL_CARRIED_NODE_USE_ENV_PROXY, and a
# preload puts it back before the hook's code runs, for what the hook spawns.
if [ "$1" = node ]; then
  if [ -z "${NODE_COMPILE_CACHE+set}" ]; then
    cache=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
    case $cache in
      /*)
        cache=$cache/squeal/compile-cache
        [ -d "$cache" ] || (umask 077 && mkdir -p "$cache") 2>/dev/null || :
        if [ -d "$cache" ] && [ -w "$cache" ]; then
          NODE_COMPILE_CACHE=$cache
          SQUEAL_OWN_COMPILE_CACHE=1
          export NODE_COMPILE_CACHE SQUEAL_OWN_COMPILE_CACHE
        fi
        ;;
    esac
  fi
  if [ -n "${NODE_USE_ENV_PROXY+set}" ]; then
    SQUEAL_CARRIED_NODE_USE_ENV_PROXY=$NODE_USE_ENV_PROXY
    export SQUEAL_CARRIED_NODE_USE_ENV_PROXY
    unset NODE_USE_ENV_PROXY
    shift
    set -- node --import "data:text/javascript,if(process.env.SQUEAL_CARRIED_NODE_USE_ENV_PROXY!==undefined){process.env.NODE_USE_ENV_PROXY=process.env.SQUEAL_CARRIED_NODE_USE_ENV_PROXY;Reflect.deleteProperty(process.env,'SQUEAL_CARRIED_NODE_USE_ENV_PROXY')}" "$@"
  fi
fi
exec "$@"
