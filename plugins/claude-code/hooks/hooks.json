{
  "description": "Squeal: validation transitions at tool boundaries, status at Stop. Every hook exits 0 silently in a repository without Squeal.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.mjs"
            ],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/waiter.mjs"
            ],
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.mjs"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/user-prompt-submit.mjs"
            ],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/waiter.mjs"
            ],
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/post-tool-batch.mjs"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/pre-tool-use.mjs"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/stop.mjs"
            ],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/waiter.mjs"
            ],
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/stop.mjs"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--disable-warning=ExperimentalWarning",
              "${CLAUDE_PLUGIN_ROOT}/dist/session-end.mjs"
            ],
            "timeout": 2
          }
        ]
      }
    ]
  }
}
