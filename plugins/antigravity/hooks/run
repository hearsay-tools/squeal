#!/bin/sh
# Every Antigravity hooks.json command (spec 024 D4). Antigravity runs a plugin
# hook with the plugin root as its working directory, so the workspace comes
# from the top-level "cwd" of the hook payload on stdin. Without arguments it
# exits 0 before it reads anything. Without --if-squeal it execs its arguments.
# With --if-squeal, the per-invocation and per-tool hooks': it buffers stdin
# byte-exact (a sentinel keeps trailing newlines), takes the first "cwd":"..."
# value, and exits 0 silently when that directory has no squeal.config.json and
# no store, with no git or other process. Anything unclear (no cwd, an empty
# cwd, a backslash escape, a cwd key past 4 KB) passes the payload to the hook.
[ "$#" -gt 0 ] || exit 0
piped=
if [ "$1" = --if-squeal ]; then
  shift
  piped=1
  # bash converts every expansion of a large UTF-8 string to wide characters
  # (about 3 ms each at 100 KB); parse bytes under C and give the hook the
  # caller's locale back. dash ignores locales.
  lc=${LC_ALL-unset}
  LC_ALL=C
  payload=$(cat; printf x)
  payload=${payload%x}
  s() {
    [ -n "$1" ] || return 1
    d=$1
    [ -f "$d/squeal.config.json" ] && return 0
    while [ ! -e "$d/.git" ]; do
      [ -n "$d" ] || return 1
      d=${d%/*}
    done
    [ -f "$d/squeal.config.json" ] && return 0
    g=$d/.git
    if [ -f "$g" ]; then
      l=
      IFS= read -r l <"$g"
      g=${l#gitdir:}
      g=${g#"${g%%[! ]*}"}
      case $g in /*) ;; *) g=$d/$g ;; esac
      c=
      [ -f "$g/commondir" ] && IFS= read -r c <"$g/commondir"
      case $c in "") ;; /*) g=$c ;; *) g=$g/$c ;; esac
    fi
    [ -e "$g/squeal" ]
  }
  # Everything before the first "cwd":" (JSON escapes every quote inside a
  # string, so this is a key). %% scans once; the # below costs the square of
  # the key's offset, so a key past 4 KB goes to the hook instead of risking
  # the timeout (Antigravity's alphabetical order puts it under 400 bytes).
  head=${payload%%\"cwd\":\"*}
  if [ "${#head}" -lt 4096 ] && [ "$head" != "$payload" ]; then
    cwd=${payload#*\"cwd\":\"}
    cwd=${cwd%%\"*}
    case $cwd in
      "" | *\\*) ;;
      *) s "$cwd" 2>/dev/null || exit 0 ;;
    esac
  fi
  if [ "$lc" = unset ]; then unset LC_ALL; else LC_ALL=$lc; fi
fi
# Spec 025 D7: a node command starts with Node's compile cache in Squeal's own
# directory when the user set none, marked SQUEAL_OWN_COMPILE_CACHE=1 so test
# processes leave it out; and without NODE_USE_ENV_PROXY's proxy setup, which
# no hook needs: the switch waits in SQUEAL_CARRIED_NODE_USE_ENV_PROXY, and a
# preload puts it back before the hook's code runs, for what the hook spawns.
# The command is node or a path ending in /node; the carry keeps that path.
case $1 in node | */node)
  if [ -z "${NODE_COMPILE_CACHE+set}" ]; then
    cache=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
    case $cache in
      /*)
        cache=$cache/squeal/compile-cache
        [ -d "$cache" ] || (umask 077 && mkdir -p "$cache") 2>/dev/null || :
        if [ -d "$cache" ] && [ -w "$cache" ]; then
          NODE_COMPILE_CACHE=$cache
          SQUEAL_OWN_COMPILE_CACHE=1
          export NODE_COMPILE_CACHE SQUEAL_OWN_COMPILE_CACHE
        fi
        ;;
    esac
  fi
  if [ -n "${NODE_USE_ENV_PROXY+set}" ]; then
    SQUEAL_CARRIED_NODE_USE_ENV_PROXY=$NODE_USE_ENV_PROXY
    export SQUEAL_CARRIED_NODE_USE_ENV_PROXY
    unset NODE_USE_ENV_PROXY
    node_cmd=$1
    shift
    set -- "$node_cmd" --import "data:text/javascript,if(process.env.SQUEAL_CARRIED_NODE_USE_ENV_PROXY!==undefined){process.env.NODE_USE_ENV_PROXY=process.env.SQUEAL_CARRIED_NODE_USE_ENV_PROXY;Reflect.deleteProperty(process.env,'SQUEAL_CARRIED_NODE_USE_ENV_PROXY')}" "$@"
  fi
  ;;
esac
if [ -n "$piped" ]; then
  printf '%s' "$payload" | "$@"
  exit
fi
exec "$@"
