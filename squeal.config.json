{
  "vitest": { "exclude": ["test/e2e/**"] },
  "baseline": { "onStart": "lookup-only" },
  "complexity": {
    "enabled": true,
    "exclude": ["**/dist/**", "**/build/**", "**/vendor/**", "**/*.min.js", "docs/**"]
  },
  "inputs": {
    "test/harness/plugin.test.ts": [
      "plugins/claude-code/**",
      "src/**/*.ts",
      ".claude-plugin/**",
      "package.json"
    ],
    "test/policy/repository-inputs.test.ts": ["squeal.config.json", "**/.gitignore"],
    "test/runners/vitest/**/*.test.ts": ["test/fixtures/vitest/**"],
    "test/harness/codex/**/*.test.ts": [
      "plugins/codex/**",
      "src/**/*.ts",
      "test/fixtures/codex-hooks/**"
    ],
    "test/plugins/codex/**/*.test.ts": ["plugins/codex/**"],
    "test/harness/opencode/**/*.test.ts": ["plugins/opencode/**", "src/**/*.ts"],
    "test/harness/pi/**/*.test.ts": ["plugins/pi/**", "src/**/*.ts"],
    "test/runners/node-test/**/*.test.ts": [
      "test/fixtures/node-test/**",
      "src/runners/node-test/runtime/**"
    ],
    "test/runners/pytest/**/*.test.ts": [
      "test/fixtures/pytest/**",
      "src/runners/pytest/runtime/**"
    ],
    "test/runners/node-test/graph-memory.test.ts": ["src/runners/node-test/graph/**"],
    "test/runners/node-test/graph-bundle.test.ts": [
      "src/runners/node-test/graph/**",
      "src/harness/build.ts"
    ],
    "test/integration/node-test.test.ts": ["src/**/*.ts", "test/fixtures/node-test/**"],
    "test/kit/vitest.test.ts": ["src/runners/observe/*.cjs"],
    "test/kit/node-test.test.ts": ["src/runners/node-test/runtime/**"],
    "test/kit/pytest.test.ts": [
      "src/runners/pytest/runtime/**",
      "test/keys/validity/python/pyproject.toml",
      "test/keys/validity/python/uv.lock"
    ]
  }
}
